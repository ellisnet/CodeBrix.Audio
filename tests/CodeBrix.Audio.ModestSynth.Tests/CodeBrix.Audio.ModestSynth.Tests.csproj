<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
  </ItemGroup>

  <!--
    CodeBrix.Audio comes along transitively - the add-on references it as an ordinary
    ProjectReference - which is what lets these tests use its FFT for the spectrum assertions.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Audio.ModestSynth\CodeBrix.Audio.ModestSynth.csproj" />
  </ItemGroup>

  <!--
    The four pieces of generated music the listening tests audition the General MIDI bank on.
    They are the OUTPUT of two Apache-2.0 models, generated locally - no third-party recording or
    score is bundled; see THIRD-PARTY-NOTICES.txt and Assets/generated-music/GENERATED-MUSIC.txt.
    They exist as files rather than as inline fixtures because they ARE the material: a phrase
    written in code proves a voicing sounds, and only music proves the bank can carry a piece.
  -->
  <ItemGroup>
    <Content Include="..\Assets\generated-music\*.mid;..\Assets\generated-music\*.abc">
      <Link>Assets\generated-music\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
