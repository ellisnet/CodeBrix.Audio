<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
    <PackageReference Include="CodeBrix.TestMocks.ApacheLicenseForever" Version="1.0.248.1105" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Audio\CodeBrix.Audio.csproj" />
    <!--
      CodeBrix.Audio references the Engine privately (it is bundled into the same NuGet package
      rather than being a dependency), so the Engine's types are not transitively visible here.
      The tests need them to exercise the codec-factory surface, hence the direct reference.
    -->
    <ProjectReference Include="..\..\src\CodeBrix.Audio.Engine\CodeBrix.Audio.Engine.csproj" />
  </ItemGroup>

  <!--
    Generated audio fixtures shared with CodeBrix.Audio.Engine.Tests. They are synthesized and
    encoded by tools/make_test_fixtures/make_fixtures.sh - no third-party audio is bundled. Most
    WAV and MP3 cases are still built in code (TestAudio.cs); these files exist because Ogg
    Vorbis and FLAC cannot reasonably be hand-assembled, and because the one MP3 case that a
    hand-built frame cannot cover - a real encoder's Xing/LAME delay and padding - needs a real
    encoder. Each .flac and the .mp3 ship with the .wav they were encoded from, which is the
    ground truth the round-trip tests compare against.
  -->
  <ItemGroup>
    <Content Include="..\Assets\audio\*.ogg;..\Assets\audio\*.flac;..\Assets\audio\*.mp3;..\Assets\audio\*.wav">
      <Link>Assets\audio\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Fixtures for the CodeBrix.Audio.Synth tests.

    The .sf2 is synthesized by tools/make_test_fixtures/make_soundfont.py - no third-party
    SoundFont is bundled. The reference vectors are Freeverb (public domain) and TinySoundFont
    (MIT), both carried over from the upstream MeltySynth suite; see THIRD-PARTY-NOTICES.txt.
  -->
  <ItemGroup>
    <Content Include="..\Assets\soundfont\*.sf2">
      <Link>Assets\soundfont\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Assets\synth\**\*">
      <Link>Assets\synth\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The Decent Sampler name list the feature cross-check reads. It is derived from the developer
    guide and lives beside the tests that use it rather than in tests/Assets, because it is a list
    of names rather than generated audio.
  -->
  <ItemGroup>
    <Content Include="Synth\DecentSampler\decent-sampler-guide-names.txt">
      <Link>Assets\decent-sampler\decent-sampler-guide-names.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
