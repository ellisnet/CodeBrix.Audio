<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Audio</AssemblyName>
    <RootNamespace>CodeBrix.Audio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Version: 1.<years since 2026>.<day of year>.<minute of day>, computed once for the whole
       repository in Directory.Build.props at the repo root. All four packages this repository
       publishes read the same $(BuildVersion) from there; see that file for the full rationale
       and MAINTAINER-README.txt, "PACKAGING AND PUBLISHING", for how a publish pins it. -->
  <PropertyGroup>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.Audio.Core.MitLicenseForever</PackageId>
    <Product>CodeBrix.Audio</Product>
    <Title>CodeBrix.Audio</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>Shared CodeBrix audio APIs for playback, recording, mixing, synthesis, codecs, MIDI, metadata and audio file processing. Retains CodeBrix.Audio and CodeBrix.Audio.Engine assembly identities. Applications reference CodeBrix.Audio.MitLicenseForever for desktop or CodeBrix.Audio.Android.ApacheLicenseForever for Android device and native codec support.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Audio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Audio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>audio;wav;mp3;ogg;vorbis;flac;midi;abc;abc-notation;abc-to-midi;abc2midi;waveform;dsp;id3;playback;recording;engine;miniaudio;packets;soundfont;sfz;dspreset;sampler;multitrack;stems;mpe;synthesis;midi-stream;CodeBrix</PackageTags>
  </PropertyGroup>

  <!-- The README.md is this package's OWN, beside this csproj, because the repo-root one is the
       desktop package's landing page and tells readers to install that id. It sits inside the
       project folder, so it is packed with Update rather than Include. AGENT-README.txt is the
       repo-root one: it documents the two assemblies this package carries. -->
  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Core owns both existing managed assemblies, retaining their names and public APIs.
       Engine remains a private project reference and its DLL/XML are packed below.
       Platform packages provide native runtime assets; Core contains none. -->
  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.Audio.Engine\CodeBrix.Audio.Engine.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeEngineAssemblyInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeEngineAssemblyInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)CodeBrix.Audio.Engine.dll" />
      <BuildOutputInPackage Include="$(OutputPath)CodeBrix.Audio.Engine.xml"
                            Condition="Exists('$(OutputPath)CodeBrix.Audio.Engine.xml')" />
    </ItemGroup>
  </Target>

</Project>
