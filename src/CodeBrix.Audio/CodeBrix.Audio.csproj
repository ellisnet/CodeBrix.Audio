<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Audio</AssemblyName>
    <RootNamespace>CodeBrix.Audio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.Audio.MitLicenseForever</PackageId>
    <Product>CodeBrix.Audio</Product>
    <Title>CodeBrix.Audio</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A fully managed audio library for playing, recording, and analyzing sound. Reads and plays common audio file formats like WAV, MP3, Ogg Vorbis, and FLAC, plays MIDI music through SoundFont or SFZ instruments, and includes a small set of signal-processing tools for analyzing audio. Also includes a full audio engine for recording, editing, mixing, and effects, with no platform-specific setup required.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Audio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Audio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>audio;wav;mp3;ogg;vorbis;flac;midi;waveform;dsp;id3;playback;recording;engine;miniaudio;packets;soundfont;sfz;synthesis;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    Bundle the CodeBrix.Audio.Engine assembly (vendored SoundFlow v1.4.1) into THIS
    single CodeBrix.Audio.MitLicenseForever package. The Engine is referenced privately
    so it is never surfaced as a NuGet dependency; its built assembly + XML docs are
    injected into lib/, and its native miniaudio runtimes - plus the LICENSE-MiniAudio.txt
    that sits beside each binary - are packed under runtimes/<rid>/native/ by the glob below.
    The standard NuGet native-asset resolution plus the Engine's own DllImportResolver
    (Backends/MiniAudio/Native.cs) load the right binary per platform; the licence file simply
    travels with it into the consuming application's output folder.
  -->
  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.Audio.Engine\CodeBrix.Audio.Engine.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeEngineAssemblyInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeEngineAssemblyInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)CodeBrix.Audio.Engine.dll" />
      <BuildOutputInPackage Include="$(OutputPath)CodeBrix.Audio.Engine.xml"
                            Condition="Exists('$(OutputPath)CodeBrix.Audio.Engine.xml')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="..\CodeBrix.Audio.Engine\Backends\MiniAudio\runtimes\**\*.*"
          Pack="true"
          PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
