<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Audio</AssemblyName>
    <RootNamespace>CodeBrix.Audio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Version: 1.<years since 2026>.<day of year>.<minute of day>, computed once for the whole
       repository in Directory.Build.props at the repo root. Both packages this repository
       publishes read the same $(BuildVersion) from there; see that file for the full rationale
       and MAINTAINER-README.txt, "PACKAGING AND PUBLISHING", for how a publish pins it. -->
  <PropertyGroup>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.Audio.MitLicenseForever</PackageId>
    <Product>CodeBrix.Audio</Product>
    <Title>CodeBrix.Audio</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A fully managed audio library for playing, recording, and analyzing sound. Reads and plays common audio file formats like WAV, MP3, Ogg Vorbis, and FLAC, plays MIDI music through SoundFont, SFZ or Decent Sampler instruments, plays several tracks as one song - including a stems download, where each part can play as its recording or as its MIDI performance - and includes a small set of signal-processing tools for analyzing audio. Also includes a full audio engine for recording, editing, mixing, and effects, with no platform-specific setup required.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Audio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Audio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>audio;wav;mp3;ogg;vorbis;flac;midi;waveform;dsp;id3;playback;recording;engine;miniaudio;packets;soundfont;sfz;dspreset;sampler;multitrack;stems;mpe;synthesis;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    Bundle the CodeBrix.Audio.Engine assembly (vendored SoundFlow v1.4.1) into THIS
    single CodeBrix.Audio.MitLicenseForever package. The Engine is referenced privately
    so it is never surfaced as a NuGet dependency; its built assembly + XML docs are
    injected into lib/, and its native miniaudio runtimes - plus the LICENSE-MiniAudio.txt
    that sits beside each binary - are packed under runtimes/<rid>/native/ by the glob below.
    The standard NuGet native-asset resolution plus the Engine's own DllImportResolver
    (Backends/MiniAudio/Native.cs) load the right binary per platform; the licence file simply
    travels with it into the consuming application's output folder.
  -->
  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.Audio.Engine\CodeBrix.Audio.Engine.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeEngineAssemblyInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeEngineAssemblyInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)CodeBrix.Audio.Engine.dll" />
      <BuildOutputInPackage Include="$(OutputPath)CodeBrix.Audio.Engine.xml"
                            Condition="Exists('$(OutputPath)CodeBrix.Audio.Engine.xml')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="..\CodeBrix.Audio.Engine\Backends\MiniAudio\runtimes\**\*.*"
          Pack="true"
          PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
