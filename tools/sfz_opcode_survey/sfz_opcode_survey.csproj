<Project Sdk="Microsoft.NET.Sdk">

  <!--
    sfz_opcode_survey - measures which SFZ opcodes real libraries actually use.

    Unlike its shell-script siblings in tools/, this one needs the SFZ parser, so it is a small
    console project referencing the library. It is NOT part of the shipped package and is NOT in
    CodeBrix.Audio.slnx: it is run directly, from this folder. See README.txt.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CodeBrix.Audio.Tools.SfzOpcodeSurvey</RootNamespace>
    <AssemblyName>sfz_opcode_survey</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Audio\CodeBrix.Audio.csproj" />
  </ItemGroup>

</Project>
