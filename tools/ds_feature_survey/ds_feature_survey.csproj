<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ds_feature_survey - measures which Decent Sampler features real libraries actually use.

    Like its sibling sfz_opcode_survey, this one needs the parser, so it is a small console project
    referencing the library. It is NOT part of the shipped package and is NOT in CodeBrix.Audio.slnx:
    it is run directly, from this folder. See README.txt.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CodeBrix.Audio.Tools.DsFeatureSurvey</RootNamespace>
    <AssemblyName>ds_feature_survey</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Audio\CodeBrix.Audio.csproj" />
  </ItemGroup>

</Project>
