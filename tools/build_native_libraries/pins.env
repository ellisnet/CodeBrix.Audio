# ==============================================================================================
# pins.env - EVERY version / commit / image pin used by tools/build_native_libraries.
# Edit here only; build.sh and container_build.sh both source this file and echo the
# resolved values at the top of every run.
# ==============================================================================================

# --- Container images -------------------------------------------------------------------------
# The manylinux images exist to fix the glibc baseline. Building on a modern desktop distro
# would bake that distro's glibc version into the .so and it would refuse to load on anything
# older; manylinux_2_28 pins the floor at glibc 2.28.
#
#   image                                  glibc  runs on
#   manylinux_2_28_x86_64                  2.28   Debian 10+, Ubuntu 20.04+, RHEL 8+
#   manylinux_2_28_aarch64                 2.28   every 64-bit Raspberry Pi OS, Ubuntu 20.04+
#   manylinux_2_39_riscv64                 2.39   Ubuntu 24.04+, Debian 13+ (all riscv64
#                                                 distros are newer than this in practice)
#
# The digest under each tag is what was actually pulled when the shipped binaries were built.
# Pass PIN_DIGEST=1 to build.sh to pull by digest instead of by tag (fully reproducible).
IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64:2026.07.19-1
IMAGE_X64_DIGEST=sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
IMAGE_ARM64=quay.io/pypa/manylinux_2_28_aarch64:2026.07.19-1
IMAGE_ARM64_DIGEST=sha256:162c81dfd3efc710732a571717d3c916a6945ebf279e879ddee3243af96fe46f
IMAGE_RISCV64=quay.io/pypa/manylinux_2_39_riscv64:2026.07.19-1
IMAGE_RISCV64_DIGEST=sha256:04b3acc69a6cebb10ac1252587d202acce6445d91c783d3f92229bb2b2483069

# --- Vendored native sources (all in-repo; nothing is fetched at build time) --------------------
# Recorded here so build-info.txt can state exactly what went into a binary.
MINIAUDIO_DIR=miniaudio-80cf7b2
MINIAUDIO_COMMIT=80cf7b2deb1c9930fdf0726b3a20ab5e47095067
MINIAUDIO_VERSION=0.11.24
STB_VORBIS_DIR=stb_vorbis-31c1ad3
STB_VORBIS_COMMIT=31c1ad37456438565541f4919958214b6e762fb4
STB_VORBIS_VERSION=1.22

# --- Build settings ---------------------------------------------------------------------------
CMAKE_BUILD_TYPE=Release

# macOS minimum deployment target - the direct equivalent of the Linux glibc ceiling, and just as
# important. With no explicit target clang stamps the BUILD HOST's OS version into
# LC_BUILD_VERSION, so a dylib built on a current Mac refuses to load on any older one. These
# values fix the floor instead of letting it drift with whoever runs the build. macos/build.sh
# passes them to CMake and then verifies the built file actually carries them.
MACOS_MIN_ARM64=11.0
MACOS_MIN_X64=10.13

# The decode smoke test input, relative to the repository root. Generated by
# tools/make_test_fixtures/make_fixtures.sh.
SMOKE_TEST_OGG=tests/Assets/audio/vorbis-tone-stereo-44100.ogg
